  "fixed_sql": [
    {
      "name": "companies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"companies\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"legal_name\" TEXT NOT NULL, \"trade_name\" TEXT NULL, \"cnpj\" TEXT NULL, \"state_registration\" TEXT NULL, \"address_street\" TEXT NULL, \"address_number\" TEXT NULL, \"address_complement\" TEXT NULL, \"address_district\" TEXT NULL, \"address_city\" TEXT NULL, \"address_state\" TEXT NULL, \"address_postal_code\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"legal_rep_name\" TEXT NULL, \"legal_rep_cpf\" TEXT NULL, \"legal_rep_phone\" TEXT NULL, \"legal_rep_email\" TEXT NULL, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "company_modules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"company_modules\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"company_id\" TEXT NOT NULL REFERENCES companies (id), \"module_type\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), PRIMARY KEY (\"id\"), UNIQUE (\"company_id\", \"module_type\"));"
        }
      ]
    },
    {
      "name": "company_authorities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"company_authorities\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"company_id\" TEXT NOT NULL REFERENCES companies (id), \"authority\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"registration_number\" TEXT NULL, \"valid_until\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"company_id\", \"authority\"));"
        }
      ]
    },
    {
      "name": "companies_cnpj_active",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX companies_cnpj_active ON companies (cnpj) WHERE cnpj IS NOT NULL AND deleted_at IS NULL"
        }
      ]
    }
  ]
